bootdelay=0
bootretry=-1
stdin=serial,button-kbd
stdout=serial
stderr=serial
autoload=0
preboot=bind /soc/rsc@17a00000 qcom_rpmh_rsc; bind /soc/rsc@17a00000/qcom,rpmhclk clk_stub; bind /soc/ssphy@88e6000 qcom-usb-ss; bind /soc/hsphy@88e3000 qcom-snps-hsphy; bind /soc/ssusb@a600000 dwc3-generic-wrapper; bind /soc/ufsphy_mem@1d87000 qcom-qmp-ufs; bind /soc/ufshc@1d84000 qcom-ufshcd; scsi scan
fastboot=fastboot -l $fastboot_addr_r usb 0
do_boot=bootefi bootmgr
bootmenu_0=Boot first available device=run do_boot
bootmenu_1=Enable fastboot mode=run fastboot
bootmenu_2=Reset device=reset
menucmd=bootmenu
bootcmd=
